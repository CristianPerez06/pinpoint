# Copy to .env and fill in. Every variable here is required, except the switch — the app
# refuses to start without it and names the one that is missing.
#
# Everything below is PUBLISHABLE: Expo inlines EXPO_PUBLIC_* into the JS
# bundle, which ships inside the installed app and can be extracted from it.
# Fine for the two below, fatal for a service_role key — never prefix one.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Optional switch, off unless set to `on`: whether a password can be changed —
# "Forgot password?" on sign-in and "Change password" in settings. Leave it off
# against the live project until an email service is connected; set it to `on`
# against the local stack.
# EXPO_PUBLIC_PASSWORD_CHANGES=on
