{
  "expo": {
    "name": "Pinpoint",
    "slug": "pinpoint",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pinpoint",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pinpoint shows where you are on the trip's map."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#171614"
          }
        }
      ]
    ],
    "locales": {
      "es": "./locales/es.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.com.pinpoint.app"
    },
    "android": {
      "package": "ar.com.pinpoint.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E39A2B"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4bfaf7a-165e-4e1a-8a57-1d1ded47be55"
      }
    },
    "owner": "cristian.perez.06"
  }
}
