{
  "expo": {
    "name": "Pinpoint",
    "slug": "pinpoint",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pinpoint",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.com.pinpoint.app"
    },
    "android": {
      "package": "ar.com.pinpoint.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1917"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4bfaf7a-165e-4e1a-8a57-1d1ded47be55"
      }
    },
    "owner": "cristian.perez.06"
  }
}
