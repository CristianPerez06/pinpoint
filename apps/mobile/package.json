{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "comment:scripts": "`dev` now starts the dev-client bundler, not Expo Go. @maplibre/maplibre-react-native contains native code and Expo Go ships a fixed set of native modules, so it cannot load it — scanning the QR code with Expo Go now fails at the point the map screen renders. Run `ios` or `android` once to produce a development build; after that `dev` attaches to it.",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@pinpoint/auth": "workspace:*",
    "@pinpoint/core": "workspace:*",
    "@pinpoint/data": "workspace:*",
    "@pinpoint/geocode": "workspace:*",
    "@pinpoint/map": "workspace:*",
    "@pinpoint/supabase": "workspace:*",
    "@pinpoint/tokens": "workspace:*",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "^57.0.13",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  }
}
